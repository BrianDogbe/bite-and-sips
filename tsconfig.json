{
  "compilerOptions": {
    "target": "ES2020",

    "useDefineForClassFields": true,

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "types": [
      "node"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,

    "noEmit": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "src/*"
      ]
    },

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src"
  ]
}